# Database
POSTGRES_USER=ct
POSTGRES_DB=control_tower
DB_PASSWORD=secret
POSTGRES_PORT=5433

# Host Ports
BACKEND_PORT=8001
CHAT_PORT=8081
DASHBOARD_PORT=8502

# LLM Provider (siliconflow | anthropic)
LLM_PROVIDER=siliconflow

# SiliconFlow (Kimi-K3)
SILICONFLOW_API_KEY=sk-your-siliconflow-key
