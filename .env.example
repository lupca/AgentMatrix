# Database
POSTGRES_USER=ct
POSTGRES_DB=control_tower
DB_PASSWORD=secret
POSTGRES_PORT=5433
REDIS_PORT=6379

# Host Ports
FRONTEND_PORT=3000
BACKEND_PORT=8001
PROJECTS_ROOT=/home/lupca/projects

# LLM Provider (siliconflow | anthropic | google | openai)
LLM_PROVIDER=siliconflow

# SiliconFlow (Kimi-K3)
SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_MODEL=moonshotai/Kimi-K3

# Anthropic (fallback)
ANTHROPIC_API_KEY=sk-ant-example-key

# OpenAI (coordinator)
OPENAI_API_KEY=sk-openai-example-key
OPENAI_MODEL=gpt-4o

# Optional
LOG_LEVEL=INFO

# Fernet-compatible secret (required for production API-key encryption)
ENCRYPTION_KEY=
