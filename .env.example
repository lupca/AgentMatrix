# Database
POSTGRES_USER=ct
POSTGRES_DB=control_tower
DB_PASSWORD=secret
POSTGRES_PORT=5433
REDIS_PORT=6379

# Host Ports
FRONTEND_PORT=3000
BACKEND_PORT=8001
PROJECTS_ROOT=/home/lupca/projects

# Optional
LOG_LEVEL=INFO

# Fernet-compatible secret (required for production API-key encryption)
ENCRYPTION_KEY=

# Scoped token for the coordinator chat CLI's MCP tool projection
# (backend/app/mcp_server.py). Unset disables MCP tool access for CLI-mode
# chat turns; cli_dispatcher.py falls back to today's tool-less behavior.
MCP_API_TOKEN=
CT_API_URL=http://localhost:8000
